# Server-only secrets. Configure these in Vercel; never prefix them with VITE_.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-server-side-turso-token
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional legacy credential for previously provisioned desktop installations.
# New installations authenticate with their normal Hymn account.
DESKTOP_SYNC_TOKEN=replace-with-at-least-32-random-characters

# Public registration is disabled unless this is explicitly set to true.
ALLOW_PUBLIC_REGISTRATION=false
